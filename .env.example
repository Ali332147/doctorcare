PORT=10000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret-before-deployment
# For local development, omit TURSO_DATABASE_URL to use a local SQLite file.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Create the first admin with these values on first startup. Change them before use.
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisPassword123!
DOCTOR_NAME=Dr. Demo
DOCTOR_SPECIALTY=General Physician
CURRENCY=BDT
# Doctor login: doctor@example.com with this password
DOCTOR_PASSWORD=ChangeDoctorPassword123!
# Hours offset from UTC for 'today' (Bangladesh = 6)
TZ_OFFSET_HOURS=6
